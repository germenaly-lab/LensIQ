{
  "openapi": "3.0.3",
  "info": {
    "title": "LensIQ Multi-Source CCTV Backend & Streaming Gateway API",
    "description": "Enterprise CCTV monitoring REST API and Streaming Gateway supporting multiple video source types (RTSP and Hikvision P2P) with zero secret leakage, single-pipeline multiplexing, and AI stream normalization.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:4000/api/v1",
      "description": "Local Development Server"
    },
    {
      "url": "https://stream.lensiq.cloud/api/v1",
      "description": "Production Streaming Gateway"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/cameras": {
      "get": {
        "summary": "List cameras with multi-tenant filtering",
        "parameters": [
          { "name": "companyId", "in": "query", "schema": { "type": "string" } },
          { "name": "branchId", "in": "query", "schema": { "type": "string" } },
          { "name": "sourceType", "in": "query", "schema": { "type": "string", "enum": ["rtsp", "hikvision_p2p"] } }
        ],
        "responses": {
          "200": {
            "description": "List of safe camera DTOs (zero credentials exposed)"
          }
        }
      },
      "post": {
        "summary": "Create a new camera (RTSP or Hikvision P2P)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCameraRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Camera successfully created and registered with credentials vault"
          },
          "400": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/cameras/{id}": {
      "get": {
        "summary": "Get camera by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Safe camera DTO" },
          "404": { "description": "Camera not found" }
        }
      }
    },
    "/streams/{cameraId}/session": {
      "post": {
        "summary": "Initiate or attach to a live streaming session",
        "description": "Orchestrates source adapter ingestion (RTSPSourceAdapter or HikvisionP2PSourceAdapter), multiplexes viewers onto a single underlying pipeline, and returns authenticated playback details.",
        "parameters": [
          { "name": "cameraId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "streamProfile": { "type": "string", "enum": ["main", "sub"], "default": "main" },
                  "protocol": { "type": "string", "enum": ["webrtc", "hls"], "default": "webrtc" },
                  "demoMode": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Unified streaming session initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedStreamSession"
                }
              }
            }
          },
          "403": { "description": "Unauthorized camera access" },
          "404": { "description": "Camera not found" }
        }
      }
    },
    "/streams/{cameraId}/reconnect": {
      "post": {
        "summary": "Trigger explicit camera reconnection",
        "description": "Re-initiates connection and acquisition sequence on the camera source adapter.",
        "parameters": [
          { "name": "cameraId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Reconnection sequence executed" }
        }
      }
    },
    "/streams/{cameraId}/stop": {
      "post": {
        "summary": "Release viewer stream session",
        "description": "Decrements viewer count. When 0 viewers remain, the idle reaper will safely stop and cleanup the underlying ingest pipeline.",
        "parameters": [
          { "name": "cameraId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessionId"],
                "properties": {
                  "sessionId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Session released" }
        }
      }
    },
    "/streams/{cameraId}/status": {
      "get": {
        "summary": "Get real-time camera health telemetry",
        "parameters": [
          { "name": "cameraId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Real-time telemetry metrics" }
        }
      }
    },
    "/streams/playback/{token}": {
      "get": {
        "summary": "Verify ephemeral playback token",
        "description": "Public playback verification endpoint called by Flutter and Web video players.",
        "parameters": [
          { "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Token verified and active session descriptor returned" },
          "401": { "description": "Invalid or expired token" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateCameraRequest": {
        "type": "object",
        "required": ["name", "company_id", "branch_id", "source_type"],
        "properties": {
          "name": { "type": "string", "example": "Cashier 01" },
          "company_id": { "type": "string", "format": "uuid" },
          "brand_id": { "type": "string", "format": "uuid" },
          "branch_id": { "type": "string", "format": "uuid" },
          "source_type": { "type": "string", "enum": ["rtsp", "hikvision_p2p"] },
          "location_description": { "type": "string", "example": "Counter 1 - Checkout" },
          "rtsp_url": { "type": "string", "example": "rtsp://camera.local/live/ch1" },
          "hik_device_id": { "type": "string", "example": "HIK-DEV-9011" },
          "hik_serial_number": { "type": "string", "example": "SER123456" },
          "hik_channel": { "type": "integer", "example": 1 },
          "credentials_payload": {
            "type": "object",
            "description": "Sensitive credentials securely registered into vault; never stored plain in database"
          },
          "stream_profile": { "type": "string", "enum": ["main", "sub"], "default": "main" }
        }
      },
      "UnifiedStreamSession": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string" },
          "camera_id": { "type": "string" },
          "source_type": { "type": "string", "enum": ["rtsp", "hikvision_p2p"] },
          "stream_url": { "type": "string" },
          "token": { "type": "string" },
          "protocol": { "type": "string", "enum": ["webrtc", "hls"] },
          "status": { "type": "string", "enum": ["active", "idle", "reconnecting", "terminating", "expired"] },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "viewer_count": { "type": "integer" },
          "demo_mode": { "type": "boolean" },
          "stream_info": {
            "type": "object",
            "properties": {
              "resolution": { "type": "string" },
              "fps": { "type": "integer" },
              "codec": { "type": "string" },
              "profile": { "type": "string" }
            }
          },
          "monitoring": {
            "type": "object",
            "properties": {
              "connection_status": { "type": "string" },
              "latency_ms": { "type": "number" },
              "reconnect_count": { "type": "integer" },
              "last_error": { "type": "string", "nullable": true },
              "last_successful_frame": { "type": "string", "nullable": true },
              "stream_start_time": { "type": "string", "nullable": true },
              "uptime_seconds": { "type": "integer" },
              "viewer_count": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
