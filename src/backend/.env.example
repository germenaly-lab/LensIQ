# ==========================================================
# LensIQ Node.js Backend Microservice Environment Variables
# ==========================================================
PORT=3001
NODE_ENV=production

# Supabase Auth & Multi-Tenant Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Streaming Gateway
STREAMING_GATEWAY_URL=http://localhost:8889
STREAM_SECURITY_SALT=generate-a-strong-random-salt-for-ephemeral-tokens
SESSION_DURATION_MS=3600000
IDLE_GRACE_PERIOD_MS=60000

# AI Microservice Communication
INTERNAL_API_SECRET=change-this-to-a-very-secure-random-token-in-production

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_SERVER_KEY=your-firebase-server-key
FIREBASE_PROJECT_ID=lensiq-enterprise
