# ==========================================================
# LensIQ AI Computer Vision Microservice Configuration
# ==========================================================

# Service Networking
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Hardware & Model
AI_DEVICE=auto              # auto | cpu | cuda | mps
MODEL_NAME=yolov8n.pt       # yolov8n.pt | yolov8s.pt | yolov8m.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
MOCK_DETECTION_MODE=false   # Set to true for mock testing without downloading model weights

# Video Frame Processing
MAX_PROCESSING_FPS=10       # Limit inference FPS per camera stream
INPUT_RESOLUTION_WIDTH=640
INPUT_RESOLUTION_HEIGHT=640

# Target Classes (Extensible beyond person: car, bag, phone, chair, package)
TARGET_CLASSES=["person", "bag", "car", "chair", "cell phone"]

# Node.js Backend Integration
NODE_BACKEND_URL=http://localhost:3000
INTERNAL_API_SECRET=lensiq-internal-service-secret-change-in-prod
EVENT_FORWARDING_ENABLED=true
