# ==========================================================
# LensIQ Enterprise Environment Variables Configuration
# ==========================================================

# ----------------------------------------------------------
# 1. Supabase Multi-Tenant Database & Auth Configuration
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ----------------------------------------------------------
# 2. Core Node.js API Backend Configuration
# ----------------------------------------------------------
PORT=3001
NODE_ENV=production
STREAMING_GATEWAY_URL=http://localhost:8889
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_SECRET=change-this-to-a-very-secure-random-token-in-production

# ----------------------------------------------------------
# 3. Streaming Gateway (MediaMTX / WebRTC / HLS)
# ----------------------------------------------------------
PUBLIC_GATEWAY_IP=127.0.0.1
STREAM_SESSION_DURATION_MS=3600000
STREAM_IDLE_GRACE_PERIOD_MS=60000

# ----------------------------------------------------------
# 4. Firebase Cloud Messaging (FCM Push Notifications)
# ----------------------------------------------------------
FIREBASE_PROJECT_ID=lensiq-enterprise
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@lensiq-enterprise.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_SERVER_KEY=your-legacy-or-oauth2-fcm-server-key

# ----------------------------------------------------------
# 5. Python Computer Vision AI Service (YOLOv8)
# ----------------------------------------------------------
CASHIER_EMPTY_THRESHOLD_SECONDS=180
DETECTION_CONFIDENCE_THRESHOLD=0.50
YOLO_MODEL=yolov8n.pt

# ----------------------------------------------------------
# 6. Hikvision Cloud Relay / ISAPI Configuration
# ----------------------------------------------------------
HIK_CONNECT_APP_KEY=your-hikvision-open-platform-appkey
HIK_CONNECT_APP_SECRET=your-hikvision-open-platform-secret
HIK_CONNECT_API_URL=https://open.hik-connect.com/artemis
